{
  "manifest_version": 3,
  "name": "YouTube Blocker Pro",
  "version": "4.1",
  "description": "Bloquez des vidéos, des chaînes, et reprenez le contrôle de votre temps.",
  "default_locale": "fr",
  "permissions": [
    "storage",
    "downloads",
    "alarms",
    "notifications",
    "contextMenus",
    "tabs",
    "declarativeNetRequest"
  ],
  "host_permissions": [
    "*://*.youtube.com/*",
    "https://extension.blocker.youtube.crossplaymc.fr/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "commands": {
    "block_current_video": {
      "suggested_key": {
        "default": "Alt+B",
        "mac": "Alt+B"
      },
      "description": "Bloquer la vidéo en cours instantanément"
    }
  },
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "32": "icon32.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "web_accessible_resources": [
    {
      "resources": [
        "popup.html",
        "popup.js",
        "utils.js",
        "styles.css",
        "content.css",
        "inject.js"
      ],
      "matches": [
        "*://*.youtube.com/*"
      ]
    }
  ],
  "content_scripts": [
    {
      "matches": [
        "*://*.youtube.com/*"
      ],
      "css": [
        "content.css"
      ],
      "js": [
        "utils.js",
        "content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "*://*.youtube.com/*"
      ],
      "js": [
        "inject.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ]
}